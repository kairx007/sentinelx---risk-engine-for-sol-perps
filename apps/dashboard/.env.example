# Public read-only Solana RPC settings. These values are bundled into the browser.
# Use a public endpoint or a provider key that is safe to expose to dashboard users.
VITE_CHAIN_RPC_URL=https://api.devnet.solana.com
VITE_CHAIN_CLUSTER=devnet

# Required: the collateral mint used when initialize_vault created the vault PDA.
# The RiskState PDA is derived from this vault; leave unset until the deployed
# vault's collateral mint is confirmed.
# Default (devnet USDC): 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
VITE_COLLATERAL_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
